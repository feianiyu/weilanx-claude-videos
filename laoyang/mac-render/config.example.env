# Mac 出片机配置（安装时复制到 ~/laoyang-render/config.env，改那一份）
# 不写的项用默认值；这个文件不进仓库，可以放密钥

# 代码仓库（你的 Fork）
REPO_URL=https://github.com/feianiyu/weilanx-claude-videos.git

# 成片放哪里（你审完再拖进发布台 ~/publish-hub 的队列）；也可以写 NAS 挂载路径
OUTBOX=~/laoyang-render/待审

# 并行渲染进程数：M1 Max 10 核用 6；觉得出片时电脑卡就改小
JOBS=6

# 报告推回 GitHub 的 render-report/<名字> 分支，Claude 直接读（安装时会自动检测能不能推）
PUSH_REPORTS=1

# 本人声音凭证（火山引擎声音复刻），不存在就用云扬
TTS_ENV=~/weilanx-claude-videos/materials/老杨魔方知识分享版/tts.env

# 本机 mlx-whisper：配音后把每句转回文字，和台词比对，抽查多音字
WHISPER_PY=~/mlx-whisper-env/bin/python
WHISPER_MODEL=mlx-community/whisper-small-mlx

# 本地模型（mlx_lm.server）：只用来把报告压成一句话通知你；没开也不影响出片
LLM_URL=http://127.0.0.1:18081/v1/chat/completions
LLM_MODEL=

# iPhone 推送（二选一，都可以不填，不填只在 Mac 上弹通知）
# Bark：App Store 装 Bark，打开后复制 https://api.day.app/ 后面那串 key
BARK_KEY=
# ntfy：App Store 装 ntfy，订阅一个只有你知道的主题名
NTFY_TOPIC=
