 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "这本书的英文名叫《1587，无关紧要的一年》。",
   "tts": "这本书的英文名叫《一五八七，无关紧要的一年》。",
   "dur": 5.08
  },
  "v02": {
   "sec": "c0",
   "sub": "那一年没出什么大事，黄仁宇却为它写了一整本书。",
   "dur": 5.08
  },
  "v03": {
   "sec": "c0",
   "sub": "很多人把它当人物故事读：张居正、海瑞、戚继光、万历皇帝。",
   "dur": 6.05
  },
  "v04": {
   "sec": "c0",
   "sub": "但作者在自序里说，全书真正想讲的，是一句话：",
   "dur": 4.82
  },
  "v05": {
   "sec": "c0",
   "sub": "中国二千年来，以道德代替法制，至明代而极，这就是一切问题的症结。",
   "dur": 6.96
  },
  "v06": {
   "sec": "c0",
   "sub": "这句话有点抽象，我换个问法：为什么那个时代最能干、最清廉、最会打仗的人，最后全都输了？",
   "dur": 9.27
  },
  "v07": {
   "sec": "c0",
   "sub": "要回答它，先得弄明白一个前提：用道德来管，到底是一种什么样的管法。",
   "dur": 7.17
  },
  "v08": {
   "sec": "c1",
   "sub": "管一个上亿人口的大组织，大致只有两种办法。",
   "dur": 4.64
  },
  "v09": {
   "sec": "c1",
   "sub": "一种按数字管：田有多少、税收多少、钱花在哪，都能算、能核、能追责。",
   "dur": 7.06
  },
  "v10": {
   "sec": "c1",
   "sub": "另一种按道德管：看你的表态、看你的名声，看合不合礼法。",
   "dur": 5.87
  },
  "v11": {
   "sec": "c1",
   "sub": "黄仁宇晚年回顾这本书，说得更直白：传统官僚组织，以仪礼代行政，",
   "dur": 6.74
  },
  "v12": {
   "sec": "c1",
   "sub": "只要在自己内部讲得通，对外可以不负责。",
   "dur": 4.21
  },
  "v13": {
   "sec": "c1",
   "sub": "他反复强调，传统中国的毛病，就是不能在数目字上管理。",
   "dur": 5.69
  },
  "v14": {
   "sec": "c2",
   "sub": "那明朝为什么不按数字管？因为账本身就算不清。",
   "dur": 4.86
  },
  "v15": {
   "sec": "c2",
   "sub": "黄仁宇专门研究过明代财政，他的结论是：税收实行定额，",
   "dur": 5.69
  },
  "v16": {
   "sec": "c2",
   "sub": "一个地方该交多少，定下来就很少再动，他管这叫铁板税。",
   "dur": 5.69
  },
  "v17": {
   "sec": "c2",
   "sub": "可人口在变，土地也在变，账面上的数字和实际越走越远。",
   "dur": 5.69
  },
  "v18": {
   "sec": "c2",
   "sub": "中央看不清真实情况，考核官员就没法看实绩，只能看态度和名声。",
   "dur": 6.56
  },
  "v19": {
   "sec": "c3",
   "sub": "所以这本书常被读成好人被坏人害了。其实不是。",
   "dur": 4.86
  },
  "v20": {
   "sec": "c3",
   "sub": "看张居正。他恰恰是最想把账算清的人，推行考成法，用簿册给官员定任务、按期核查。",
   "dur": 8.44
  },
  "v21": {
   "sec": "c3",
   "sub": "可这套办法，靠的是他首辅的个人权威。",
   "dur": 3.99
  },
  "v22": {
   "sec": "c3",
   "sub": "父亲去世，按礼制他该辞官回乡守孝，他没有，被一批官员从道德上猛烈攻击。",
   "dur": 7.61
  },
  "v23": {
   "sec": "c3",
   "sub": "他一死，清算就来了，两年后被抄了家。",
   "dur": 3.95
  },
  "v24": {
   "sec": "c3",
   "sub": "算账的人，最后输给了讲道德的规则。",
   "dur": 3.77
  },
  "v25": {
   "sec": "c4",
   "sub": "再看另外几个人，输法不同，原因是同一个。",
   "dur": 4.39
  },
  "v26": {
   "sec": "c4",
   "sub": "戚继光最能打。张居正死后七个月，他被调去广东，",
   "dur": 5.04
  },
  "v27": {
   "sec": "c4",
   "sub": "接着和李成梁一起，被参劾为前首辅的党羽。",
   "dur": 4.42
  },
  "v28": {
   "sec": "c4",
   "sub": "皇帝原谅了李成梁，却把戚继光革了职。",
   "dur": 3.99
  },
  "v29": {
   "sec": "c4",
   "sub": "参他的理由，不是仗打得好不好，而是站在谁一边。",
   "dur": 5.04
  },
  "v30": {
   "sec": "c4",
   "sub": "海瑞的道德近乎完美，朝廷敬着他，可他要按开国时的祖制办事，在现实里处处办不通。",
   "dur": 8.48
  },
  "v31": {
   "sec": "c4",
   "sub": "万历皇帝权力最大，也一样被礼法捆住：他想立自己喜欢的儿子当太子，文官们搬出祖制力争。",
   "dur": 9.13
  },
  "v32": {
   "sec": "c4",
   "sub": "他最后的反抗，是长年不上朝。",
   "dur": 3.12
  },
  "v33": {
   "sec": "c5",
   "sub": "当然，史学界对这本书也有批评：有学者指出，明代的定额并非一成不变，也有人批评它以论带史。",
   "dur": 9.53
  },
  "v34": {
   "sec": "c5",
   "sub": "但它提出的问题，今天依然成立：",
   "dur": 3.34
  },
  "v35": {
   "sec": "c5",
   "sub": "一个组织算不清账，就只能用道德管人；",
   "dur": 3.99
  },
  "v36": {
   "sec": "c5",
   "sub": "而用道德管人，必然奖励表态，惩罚做事。",
   "dur": 4.17
  },
  "v37": {
   "sec": "c5",
   "sub": "所以《万历十五年》讲的不是好人和坏人，而是一个算不清账的系统，怎样把最能干的人一个个耗掉。",
   "dur": 9.82
  },
  "v38": {
   "sec": "c5",
   "sub": "放到一家企业里也一样：业绩算不清的地方，考核最后一定会变成看态度。",
   "dur": 7.21
  },
  "v39": {
   "sec": "c5",
   "sub": "下一期，接着讲张居正的考成法和一条鞭法：他想怎么把账算清，又为什么没能救下明朝。",
   "dur": 8.7
  },
  "v40": {
   "sec": "c5",
   "sub": "你怎么看这本书，欢迎在评论区聊聊。",
   "dur": 3.77
  }
 }
}