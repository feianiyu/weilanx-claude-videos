 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "1587年，万历十五年。没有天灾，没有战乱，史书几乎无事可记。",
   "tts": "一五八七年，万历十五年。没有天灾，没有战乱，史书几乎无事可记。",
   "dur": 6.7
  },
  "v02": {
   "sec": "c0",
   "sub": "可就在这一年，表面四海升平，这个王朝其实已经走到了尽头。",
   "dur": 6.12
  },
  "v03": {
   "sec": "c1",
   "sub": "书里写了六个人，几乎集齐了一个时代的顶配。",
   "dur": 4.64
  },
  "v04": {
   "sec": "c1",
   "sub": "张居正最敢改，死后被抄家清算。",
   "dur": 3.34
  },
  "v05": {
   "sec": "c1",
   "sub": "申时行最会圆，一辈子和稀泥，谁也没得罪，也没救下局。",
   "tts": "申时形最会圆，一辈子活稀泥，谁也没得罪，也没救下局。",
   "dur": 5.65
  },
  "v06": {
   "sec": "c1",
   "sub": "海瑞最清廉，被朝廷供着、敬着，就是没人听。",
   "tts": "海瑞最清廉，被朝廷贡着、敬着，就是没人听。",
   "dur": 4.57
  },
  "v07": {
   "sec": "c1",
   "sub": "戚继光最能打，靠山一倒，就被罢了官。",
   "dur": 3.95
  },
  "v08": {
   "sec": "c1",
   "sub": "万历皇帝权力最大，最后干脆长年不上朝。",
   "dur": 4.21
  },
  "v09": {
   "sec": "c1",
   "sub": "李贽最清醒，最后死在狱中。",
   "dur": 2.9
  },
  "v10": {
   "sec": "c1",
   "sub": "所有人都没错，所有人都尽力了，可所有人，都输了。",
   "dur": 5.22
  },
  "v11": {
   "sec": "c2",
   "sub": "病根说穿了就一个：拿道德代替制度，到明朝走到了极致。",
   "dur": 5.69
  },
  "v12": {
   "sec": "c2",
   "sub": "办事讲人情，不讲流程；用人讲口碑，不讲能力。",
   "dur": 4.78
  },
  "v13": {
   "sec": "c2",
   "sub": "好人束手束脚，能人处处受限，平庸的人反而安稳。",
   "dur": 5.04
  },
  "v14": {
   "sec": "c3",
   "sub": "很多团队也是这样：不是突然崩盘，是规则慢慢失效。",
   "dur": 5.26
  },
  "v15": {
   "sec": "c3",
   "sub": "每个人都很忙，系统却只剩内耗。",
   "dur": 3.34
  },
  "v16": {
   "sec": "c4",
   "sub": "我的判断：个人的努力决定下限，所在的系统决定上限。",
   "dur": 5.47
  },
  "v17": {
   "sec": "c4",
   "sub": "读懂它不是为了躺平，是别再把系统的问题，全怪到自己头上。",
   "dur": 6.12
  },
  "v18": {
   "sec": "c5",
   "sub": "你身边的困局，更像是人不行，还是路不通？",
   "dur": 4.39
  }
 }
}