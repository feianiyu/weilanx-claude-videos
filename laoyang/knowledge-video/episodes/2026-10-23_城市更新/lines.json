 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "上海“十五五”要盘活75平方公里低效产业用地，更新150栋商务楼宇。",
   "tts": "上海十五五要盘活七十五平方公里低效产业用地，更新一百五十栋商务楼宇。",
   "dur": 7.47
  },
  "v02": {
   "sec": "c0",
   "sub": "但这批活，不是谁会设计、谁会施工，谁就能拿到。",
   "dur": 5.0
  },
  "v03": {
   "sec": "c1",
   "sub": "10月22日发布的《2026中国城市更新年度报告》说得很明确：城市更新正在从工程改造，走向长期运营。",
   "tts": "十月二十二日发布的二零二六中国城市更新年度报告说得很明确：城市更新正在从工程改造，走向长期运营。",
   "dur": 10.47
  },
  "v04": {
   "sec": "c1",
   "sub": "过去项目交付就结束，现在从策划阶段就要定清楚：改完之后谁来运营，靠什么产生持续收入。",
   "dur": 9.13
  },
  "v05": {
   "sec": "c2",
   "sub": "规模已经定下来了。《城市更新“十五五”规划》列了10项指标、23项重点任务、14项重大工程。",
   "tts": "规模已经定下来了。城市更新十五五规划列了十项指标、二十三项重点任务、十四项重大工程。",
   "dur": 9.13
  },
  "v06": {
   "sec": "c2",
   "sub": "到今年9月底，至少43个省市公布了量化任务，任务正在变成一个个具体项目。",
   "tts": "到今年九月底，至少四十三个省市公布了量化任务，任务正在变成一个个具体项目。",
   "dur": 8.08
  },
  "v07": {
   "sec": "c2",
   "sub": "北京2026年第一批就纳入1321个项目，年度计划投资1049.5亿元。",
   "tts": "北京二零二六年第一批就纳入一千三百二十一个项目，年度计划投资一千零四十九点五亿元。",
   "dur": 8.99,
   "screens": [
    "北京2026年第一批|就纳入1321个项目，",
    "年度计划投资1049.5亿元。"
   ]
  },
  "v08": {
   "sec": "c2",
   "sub": "钱不少，但分钱的标准变了。",
   "dur": 2.9
  },
  "v09": {
   "sec": "c3",
   "sub": "报告对企业说得直接：机会已经从工程建设，延伸到资产整合、招商租赁、商业经营和社区服务。",
   "dur": 9.31
  },
  "v10": {
   "sec": "c3",
   "sub": "只做一段的，只能拿到一次性的钱；能把改造和运营接起来的，才有后面的持续收入。",
   "dur": 8.26
  },
  "v11": {
   "sec": "c4",
   "sub": "以后看一个更新项目，不只看改得好不好，还要看改完能不能一直用下去、经营下去。",
   "dur": 8.26
  },
  "v12": {
   "sec": "c5",
   "sub": "设计院和工程公司的老板，今天先做一件事：把手上的更新类项目列出来，每个项目写清三项：",
   "tts": "设计院和工程公司的老板，今天先做一件事：把手上的更新类项目列出来，每个项目写清三项：",
   "dur": 9.13
  },
  "v13": {
   "sec": "c5",
   "sub": "交付后谁运营、运营收入从哪来、你们能多做哪一段。",
   "dur": 5.26
  },
  "v14": {
   "sec": "c5",
   "sub": "写不出来的那一段，就是你们缺的能力。",
   "dur": 3.99
  },
  "v15": {
   "sec": "c5",
   "sub": "要么自己建，要么找合作，要么收购一家小的专业公司补上。",
   "dur": 5.91
  }
 },
