 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "很多老板见买家，开口先报去年营收多少、利润多少。",
   "dur": 4.25
  },
  "v02": {
   "sec": "c0",
   "sub": "买家心里想的是另外几件事：资质还能用几年，大客户稳不稳，核心团队走不走。",
   "dur": 6.72
  },
  "v03": {
   "sec": "c1",
   "sub": "所以见面要说清三句话。",
   "dur": 2.42
  },
  "v04": {
   "sec": "c1",
   "sub": "你稀缺在哪。资质、牌照、在一个地区的地位、大客户，这些是对方花钱也一时买不到的。",
   "dur": 7.32
  },
  "v05": {
   "sec": "c1",
   "sub": "你的风险在哪。债务、担保、历史遗留的问题，主动讲。买家最怕的，是事后才发现的问题。",
   "dur": 7.66
  },
  "v06": {
   "sec": "c1",
   "sub": "交割以后谁来干。创始人留不留，团队稳不稳，直接影响对方敢出多少价。",
   "dur": 6.1
  },
  "v07": {
   "sec": "c2",
   "sub": "这三句话里，你最难开口的是哪一句？",
   "dur": 3.05
  }
 },
 "endNext": ""
