 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "你公司越做越大，老板却越来越累。",
   "emo": "hook"
  },
  "v02": {
   "sec": "c1",
   "sub": "好公司都有一个飞轮：产品好，客户多，利润高，再投回产品，越转越快。",
   "emo": "story"
  },
  "v03": {
   "sec": "c1",
   "sub": "可一旦利润被抽走，不再投回去，飞轮就在这里断了。",
   "emo": "turn"
  },
  "v04": {
   "sec": "c2",
   "sub": "老板累，拆开看是三件事：决策太多，信息太慢，人才太少。",
   "emo": "list"
  },
  "v05": {
   "sec": "c2",
   "sub": "一百个想法，能立项的三十个，真做成的，不到五个。",
   "emo": "num"
  },
  "v06": {
   "sec": "c2",
   "sub": "换句话说，每一百个想法里，只有五个能落地。",
   "emo": "heavy"
  },
  "v07": {
   "sec": "c3",
   "sub": "能力是一层层垒起来的：最底下是流程，往上是组织，顶上才是战略。",
   "emo": "story"
  },
  "v08": {
   "sec": "c3",
   "sub": "很多公司走过的路都差不多：先靠机会，再靠管理，然后靠体系。大多数，卡在第二步。",
   "emo": "story"
  },
  "v09": {
   "sec": "c3",
   "sub": "成长有三级台阶：老板一个人干，带一个团队干，建一套机制干。",
   "emo": "list"
  },
  "v10": {
   "sec": "c4",
   "sub": "好业务要同时满足三件事：客户要，你能做，还赚钱。三个圈的交集，才是主航道。",
   "emo": "aha"
  },
  "v11": {
   "sec": "c4",
   "sub": "一百块收入，成本拿走六十，费用二十，税五块，真落到手里的，只有十五块。",
   "emo": "num"
  },
  "v12": {
   "sec": "c4",
   "sub": "再看费用，销售费用占了一大半。",
   "emo": "fact"
  },
  "v13": {
   "sec": "c5",
   "sub": "利润下滑只是水面上的。水面下，是定价权，是客户结构，是组织效率。",
   "emo": "aha"
  },
  "v14": {
   "sec": "c5",
   "sub": "以前靠关系拿单，现在靠产品拿单；以前老板拍板，现在数据说话。",
   "emo": "turn"
  },
  "v15": {
   "sec": "c5",
   "sub": "推着你变的，是客户在变、技术在变；拦着你的，是老习惯和旧利益。哪边力气大，公司就往哪边走。",
   "emo": "heavy"
  },
  "v16": {
   "sec": "c5",
   "sub": "结构不变，再勤奋，也只是原地跑。",
   "emo": "金句：一句一顿，越说越笃定"
  },
  "v17": {
   "sec": "c5",
   "sub": "评论区说说，你公司现在卡在哪一层？",
   "emo": "invite"
  }
