 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "设想一家做零部件的工厂，老板把总经理交给了刚回国的儿子。",
   "dur": 4.7
  },
  "v02": {
   "sec": "c0",
   "sub": "儿子上任先推制度：采购三级审批，付款统一月结。",
   "dur": 4.27
  },
  "v03": {
   "sec": "c1",
   "sub": "几个月后，合作十几年的大客户订单砍了一半。对方说，以前一个电话，急单当天就能插进去，现在走流程要两周。",
   "dur": 9.48
  },
  "v04": {
   "sec": "c1",
   "sub": "又一家客户把账期压短，原话是：我们信的是你父亲这个人。",
   "dur": 4.7
  },
  "v05": {
   "sec": "c1",
   "sub": "跟了老板十几年的销售副总也走了，带走了几个区域的客户。",
   "dur": 4.56
  },
  "v06": {
   "sec": "c2",
   "sub": "制度本身没错。老客户、老供应商、老部下认的是老板这个人，股权过户了，这份信任没有跟着过来。",
   "dur": 7.94
  },
  "v07": {
   "sec": "c3",
   "sub": "接班之前，先把核心客户一个个过一遍：他认的是公司，还是老板本人。",
   "dur": 5.62
  },
  "v08": {
   "sec": "c3",
   "sub": "你们公司最大的三个客户，认的是谁？",
   "dur": 3.17
  }
 },
 "endNext": ""
