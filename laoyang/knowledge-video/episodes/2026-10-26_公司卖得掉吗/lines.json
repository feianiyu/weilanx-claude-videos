 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "做了十几二十年，一直在赚钱。",
   "dur": 2.76
  },
  "v02": {
   "sec": "c0",
   "sub": "但你有没有想过——如果今天想退出，它卖得掉吗？能卖多少？",
   "tts": "但你有没有想过，如果今天想退出，它卖得掉吗？能卖多少？",
   "dur": 4.78
  },
  "v03": {
   "sec": "c1",
   "sub": "华东有个老板，公司做了二十年。",
   "dur": 2.62
  },
  "v04": {
   "sec": "c1",
   "sub": "前几年行情好，有人上门要收，出价不低。",
   "dur": 3.94
  },
  "v05": {
   "sec": "c1",
   "sub": "他舍不得，觉得还能再干几年。",
   "dur": 2.76
  },
  "v06": {
   "sec": "c1",
   "sub": "这两年现金流紧了，他回头想卖——同一批买家，有的直接压价一半，有的不接电话了。",
   "tts": "这两年现金流紧了，他回头想卖。同一批买家，有的直接压价一半，有的不接电话了。",
   "dur": 7.46,
   "screens": [
    "这两年现金流紧了，|他回头想卖——",
    "同一批买家，有的直接压价一半，|有的不接电话了。"
   ]
  },
  "v07": {
   "sec": "c2",
   "sub": "这不是他运气差，规律就是这样。",
   "dur": 2.76
  },
  "v08": {
   "sec": "c2",
   "sub": "公司最值钱的时候，恰恰是它最赚钱、你最舍不得卖的时候。",
   "dur": 4.94
  },
  "v09": {
   "sec": "c2",
   "sub": "等你撑不住、急着出手，买家一闻到味道，价格立刻腰斩。",
   "dur": 4.97
  },
  "v10": {
   "sec": "c2",
   "sub": "你越急，它越不值钱。",
   "dur": 2.42
  },
  "v11": {
   "sec": "c3",
   "sub": "我做了二十多年并购，看过的卖家比大多数人一辈子见的都多。",
   "dur": 4.61
  },
  "v12": {
   "sec": "c3",
   "sub": "能卖上价的公司都有一个共同点：离了老板本人，它照样转——账目清楚、客户不只认你一个、团队顶得上。",
   "tts": "能卖上价的公司都有一个共同点：离了老板本人，它照样赚。账目清楚、客户不只认你一个、团队顶得上。",
   "dur": 9.07,
   "screens": [
    "能卖上价的公司都有一个共同点：|离了老板本人，它照样转——",
    "账目清楚、客户不只认你一个、|团队顶得上。"
   ]
  },
  "v13": {
   "sec": "c3",
   "sub": "反过来，什么都压在老板一个人身上的公司，买家看一眼就懂：这买的不是公司，是你这个人。",
   "dur": 7.27
  },
  "v14": {
   "sec": "c3",
   "sub": "那就不值钱。",
   "dur": 1.61
  },
  "v15": {
   "sec": "c4",
   "sub": "所以真正的高手，都在不缺钱、根本没想卖的时候，就把公司收拾成“随时能卖”的样子。",
   "dur": 7.27
  },
  "v16": {
   "sec": "c4",
   "sub": "不是为了卖，是为了有的选。",
   "dur": 2.62
  },
  "v17": {
   "sec": "c4",
   "sub": "明天就能做的三件事：把账理干净；把最大的客户从“只认你”变成“认公司”；把你一个人扛的事，先分一件出去。",
   "dur": 9.29,
   "screens": [
    "明天就能做的三件事：|把账理干净；",
    "把最大的客户从“只认你”|变成“认公司”；",
    "把你一个人扛的事，|先分一件出去。"
   ]
  },
  "v18": {
   "sec": "c5",
   "sub": "刚起步、还在拼命长的公司，不用急着干这个。",
   "tts": "刚起步、还在拼命涨的公司，不用急着干这个。",
   "dur": 4.1
  },
  "v19": {
   "sec": "c5",
   "sub": "但只要你过了生存线，这件事越早做越主动。",
   "dur": 3.94
  },
  "v20": {
   "sec": "c5",
   "sub": "一家你随时能卖掉的公司，平时也更抗折腾、更值钱。",
   "dur": 4.78
  }
 },
