 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "高技术制造业增长14.3%，消费才增长1.1%。",
   "emo": "hook"
  },
  "v02": {
   "sec": "c0",
   "sub": "法国巴黎银行10月底发了一篇报告，专门解释这个怪现象：出口这么强，国内企业为什么还难？",
   "emo": "平稳交代来源，到“为什么还难”略压低放慢，说完停半拍"
  },
  "v03": {
   "sec": "c0",
   "sub": "它的答案是：中国经济成了“K型”，两头往相反的方向走。",
   "emo": "turn"
  },
  "v04": {
   "sec": "c0",
   "sub": "更要紧的是，你的企业在哪一头，钱会不会变成现金。",
   "emo": "ask"
  },
  "v05": {
   "sec": "c1",
   "sub": "K型，就是总量还在涨，但有的往上，有的往下。",
   "emo": "warm"
  },
  "v06": {
   "sec": "c1",
   "sub": "往上的：高技术制造、出口、人工智能设备。往下的：房地产，和它的上下游。",
   "emo": "list"
  },
  "v07": {
   "sec": "c1",
   "sub": "前三季度，房地产开发投资下降20.6%，电子行业利润却涨了103.8%。",
   "emo": "num"
  },
  "v08": {
   "sec": "c1",
   "sub": "同样是工业，汽车制造业利润降了22.8%，黑色金属冶炼降了73.3%。",
   "emo": "num"
  },
  "v09": {
   "sec": "c1",
   "sub": "所以工业利润整体涨15.5%，并不代表每个行业都在赚钱。",
   "emo": "turn"
  },
  "v10": {
   "sec": "c2",
   "sub": "那出口这么强，好处为什么没流到每家企业？",
   "emo": "ask"
  },
  "v11": {
   "sec": "c2",
   "sub": "报告预计，净出口今年贡献了约三分之一的经济增长。",
   "emo": "fact"
  },
  "v12": {
   "sec": "c2",
   "sub": "但出口额涨，不等于数量涨、利润涨，收益会集中在有技术、有议价权的企业手里。",
   "emo": "heavy"
  },
  "v13": {
   "sec": "c2",
   "sub": "房地产一调整，施工、建材、设计、地方财政，一路跟着承压。",
   "emo": "heavy"
  },
  "v14": {
   "sec": "c2",
   "sub": "所以出口强和内需弱，完全可以同时发生。",
   "emo": "aha"
  },
  "v15": {
   "sec": "c3",
   "sub": "还有更扎心的一层：企业有收入，不等于有现金。",
   "emo": "heavy"
  },
  "v16": {
   "sec": "c3",
   "sub": "收入是账上的，利润是扣完成本剩的，现金流是客户真付的钱。",
   "emo": "list"
  },
  "v17": {
   "sec": "c3",
   "sub": "9月末，规模以上工业企业的应收账款是29.77万亿元，同比增长10%。",
   "emo": "num"
  },
  "v18": {
   "sec": "c3",
   "sub": "平均回款71.6天，比去年多了1.3天；私营企业要75.7天。",
   "emo": "num"
  },
  "v19": {
   "sec": "c3",
   "sub": "账面不亏，客户晚付钱，工资和材料款照样得按时发。资金紧，往往先出在这里。",
   "emo": "heavy"
  },
  "v20": {
   "sec": "c4",
   "sub": "增长还在，但它没有平均分给每家企业。",
   "emo": "一句一顿，越说越笃定，最后几个字压低放慢，说完留白"
  },
  "v21": {
   "sec": "c5",
   "sub": "那为什么不赶紧转向消费？报告给了三个原因。",
   "emo": "ask"
  },
  "v22": {
   "sec": "c5",
   "sub": "一是房地产退下来，得有新增长和就业来接，先进制造和出口能接住。",
   "emo": "list"
  },
  "v23": {
   "sec": "c5",
   "sub": "二是技术和供应链安全，不只是经济账。",
   "emo": "list"
  },
  "v24": {
   "sec": "c5",
   "sub": "三是医疗养老保障要长期花钱，地方财政和人口老龄化都在加压。",
   "emo": "list"
  },
  "v25": {
   "sec": "c5",
   "sub": "说白了：产业项目见效快，保障改善消费信心，见效慢。",
   "emo": "aha"
  },
  "v26": {
   "sec": "c6",
   "sub": "要记得，这是一家银行的分析，政策动机没法从数据里直接证明。",
   "emo": "warm"
  },
  "v27": {
   "sec": "c6",
   "sub": "对你的企业：先看你在K型的哪一头，再看收入有没有变成现金。",
   "emo": "aha"
  },
  "v28": {
   "sec": "c6",
   "sub": "你的回款周期，比去年长了几天？评论区说说。",
   "emo": "invite"
  }
 },
