  "v13": {
   "sec": "c3",
   "sub": "时间一长，你越来越忙，团队越来越「不担事」。",
   "dur": 4.1
  },
  "v14": {
   "sec": "c4",
   "sub": "下次想说「你看着办」，换成三句话：",
   "dur": 3.43
  },
