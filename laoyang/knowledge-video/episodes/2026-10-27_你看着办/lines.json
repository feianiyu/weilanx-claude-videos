  },
  "v03": {
   "sec": "c0",
   "sub": "员工听到的却是：办砸了，算你的。",
   "dur": 3.46
  },
  "v04": {
   "sec": "c1",
   "sub": "一件事交下去，老板说：你看着办。",
   "dur": 3.1
  },
  "v05": {
   "sec": "c1",
   "sub": "三天后，员工拿来三个方案，请你挑。",
   "dur": 3.41
  },
  "v06": {
   "sec": "c1",
   "sub": "你火了：这点事还要问我？",
   "dur": 2.42
  },
  "v07": {
   "sec": "c1",
   "sub": "他也委屈：上次我自己定了，你说不对。",
   "dur": 3.62
  },
  "v08": {
   "sec": "c2",
   "sub": "问题不在员工不担事。",
   "dur": 2.11
  },
  "v09": {
   "sec": "c2",
   "sub": "是「你看着办」这四个字，少说了三件事：",
   "dur": 3.6
  },
  "v10": {
   "sec": "c2",
   "sub": "要什么结果，能动用多少，到哪一步必须回来找你。",
