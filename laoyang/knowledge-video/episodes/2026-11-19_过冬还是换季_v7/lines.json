  "v26": {
   "sec": "c2",
   "sub": "2023年，他讲的是「价值定力」。",
   "emo": "list"
  },
  "v27": {
   "sec": "c2",
   "sub": "市场开始变化，企业首先要想清楚：客户为什么选你？你的价值从哪里来？",
   "emo": "ask"
