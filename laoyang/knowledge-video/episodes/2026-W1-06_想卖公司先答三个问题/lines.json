 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "想卖公司的老板，常常一上来就问：现在还能卖掉吗？",
   "dur": 3.96
  },
  "v02": {
   "sec": "c0",
   "sub": "找买家之前，先回答三个问题。",
   "dur": 2.74
  },
  "v03": {
   "sec": "c1",
   "sub": "谁最需要你。同行要市场和区域，上下游要打通产业链，想进这个行业的人要你的资质和客户，产业资本和国资要稳定的现金流。",
   "dur": 10.25
  },
  "v04": {
   "sec": "c1",
   "sub": "你卖的是什么。是资质，是客户，是团队，还是一块地方的市场。",
   "dur": 5.33
  },
  "v05": {
   "sec": "c1",
   "sub": "你能不能撑到买家出现。卖公司常常要谈很久，急着卖的人没有议价的余地。",
   "dur": 5.93
  },
  "v06": {
   "sec": "c2",
   "sub": "把最需要你的十家写下来，每家写一句：他为什么需要你。写不出来，就先别去谈。",
   "dur": 7.06
  },
  "v07": {
   "sec": "c3",
   "sub": "你的公司，最需要它的会是哪一类买家？",
   "dur": 3.34
  }
 },
 "endNext": ""
