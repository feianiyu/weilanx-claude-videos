 "publish": {
  "title": "美国学者看中国出口与内需",
  "dy_title": "美国学者怎么看中国经济的出口与内需？",
  "desc": "今年，中国房地产投资下降近两成，零售额几乎没增长，出口却在猛增。布鲁金斯学会10月底的一期播客，请来荣鼎集团的洛根·赖特和圣母大学的玛丽·加拉格尔，讨论这一轮压力。他们认为，出口很强和内需偏弱，其实是同一件事的两面。你的增长，是靠卖得更多，还是卖得更贵？",
  "tags": [
   "#民营企业",
   "#宏观经济",
   "#出口",
   "#中美竞争"
  ]
 },
 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "今年，中国房地产投资下降近两成，零售额几乎没增长，出口却在猛增。",
   "emo": "hook"
  },
  "v02": {
   "sec": "c0",
   "sub": "这是美国布鲁金斯学会10月底的一期播客，主题是：怎么看中国经济的这一轮压力。",
   "emo": "fact"
  },
  "v03": {
   "sec": "c0",
   "sub": "嘉宾是荣鼎集团合伙人洛根·赖特，还有圣母大学的玛丽·加拉格尔教授。",
   "emo": "fact"
  },
  "v04": {
   "sec": "c0",
   "sub": "今天就看看，美国学者是怎么讨论我们这一轮经济压力的。",
   "emo": "带点好奇，轻轻一转，像把听众拉到身边"
  },
  "v05": {
   "sec": "c1",
   "sub": "赖特的第一个判断：增长放缓，根子在信贷。靠信贷扩张推动增长的工具，现在没什么余力了。",
   "emo": "num"
  },
  "v06": {
   "sec": "c1",
   "sub": "他说，坏账出现以后，没有让企业大面积出清，而是继续给国企和地方融资平台放贷。",
   "emo": "story"
  },
  "v07": {
   "sec": "c1",
   "sub": "为什么？他认为，当时的决策者，更看重短期的增长和信心。",
   "emo": "ask"
  },
  "v08": {
   "sec": "c1",
   "sub": "地产是另一个环节。加拉格尔说，地方政府很依赖卖地收入，家庭也因为房价下跌，觉得自己变穷了。",
   "emo": "story"
  },
  "v09": {
   "sec": "c1",
   "sub": "赖特补充：地产靠信贷撑起来，开发商又靠预售融资，疫情封控一来，预售模式就断了。",
   "emo": "heavy"
  },
  "v10": {
   "sec": "c2",
   "sub": "再看就业。加拉格尔说，官方失业率在5%左右，但没有把返乡的农民工算进去。",
   "emo": "num"
  },
  "v11": {
   "sec": "c2",
   "sub": "青年失业率，8月约19%；接近一半的劳动者在零工、平台这类非正规岗位，社保覆盖不足。",
   "emo": "num"
  },
  "v12": {
   "sec": "c3",
   "sub": "那出口为什么还这么强？赖特的回答是：出口强和国内通缩，其实是同一件事。",
   "emo": "aha"
  },
  "v13": {
   "sec": "c3",
   "sub": "靠降价抢份额，利润薄，工资也涨不上去。加拉格尔把它叫“无序竞争”，说这是一枚硬币的两面。",
   "emo": "story"
  },
  "v14": {
   "sec": "c3",
   "sub": "但这条路有上限：赖特认为，中国是在跟别人抢一块正在变小的全球需求。",
   "emo": "heavy"
  },
  "v15": {
   "sec": "c3",
   "sub": "他说，出口增长有三个上限：行业的、宏观的，还有政治的。",
   "emo": "list"
  },
  "v16": {
   "sec": "c3",
   "sub": "欧洲的汽车保障措施安排，在他看来是个信号，以后类似的案例会更多。",
   "emo": "fact"
  },
  "v17": {
   "sec": "c4",
   "sub": "那怎么办？赖特列了几个办法，比如把国企股份划进养老金，抹平农民工的养老金差距。",
   "emo": "ask"
  },
  "v18": {
   "sec": "c4",
   "sub": "他也承认，这些办法短期都会拖慢增长，因为弱一点的企业会撑不下去。",
   "emo": "turn"
  },
  "v19": {
   "sec": "c4",
   "sub": "对未来五年，两位都不乐观。赖特认为，这套模式最先会在出口受阻时露出问题。",
   "emo": "heavy"
  },
  "v20": {
   "sec": "c5",
   "sub": "总之，这场对谈的核心，是把中国的出口强和内需弱，看成同一件事的两面。",
   "emo": "close"
  },
  "v21": {
   "sec": "c5",
   "sub": "读的时候要记得，赖特写过一本书，书名就叫《破碎的中国》，他的看法偏悲观。",
   "emo": "warm"
  },
  "v22": {
   "sec": "c5",
   "sub": "对企业家来说，问题可能不在谁说得对：你的增长，是靠卖得更多，还是卖得更贵？",
   "emo": "aha"
  },
  "v23": {
   "sec": "c5",
   "sub": "各位觉得，你所在的行业，是在靠降价抢份额，还是靠别的赢？欢迎评论区聊聊。",
   "emo": "invite"
  }
 },
