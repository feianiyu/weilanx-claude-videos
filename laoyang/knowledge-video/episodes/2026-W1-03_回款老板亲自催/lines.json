 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "很多老板不好意思催款，怕伤了客户感情。",
   "dur": 3.34
  },
  "v02": {
   "sec": "c0",
   "sub": "想一下两头：客户拖你三个月，你不好意思开口；你要是因此撑不住，欠供应商的货款就还不上了。",
   "dur": 7.06
  },
  "v03": {
   "sec": "c1",
   "sub": "所以回款不能只交给财务和销售。",
   "dur": 3.02
  },
  "v04": {
   "sec": "c1",
   "sub": "设想一个老板这样做：每周一，亲自给欠款最多的三个客户打电话，问清楚哪天能付、卡在哪个环节。",
   "dur": 7.49
  },
  "v05": {
   "sec": "c1",
   "sub": "新签的订单，先谈好什么时候付、分几次付，再谈价格。",
   "dur": 4.58
  },
  "v06": {
   "sec": "c2",
   "sub": "真缺钱了，早点跟供应商和银行开口。拖到发不出工资再说，对方只会担心你要跑。",
   "dur": 6.55
  },
  "v07": {
   "sec": "c3",
   "sub": "这周一，你会给哪三个客户打电话？",
   "dur": 2.86
  }
 },
