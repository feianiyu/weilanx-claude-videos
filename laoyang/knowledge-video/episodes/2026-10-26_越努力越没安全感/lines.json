 "lines": {
  "v01": {
   "sec": "c0",
   "sub": "你有没有过这样的感觉？",
   "dur": 2.09
  },
  "v02": {
   "sec": "c0",
   "sub": "每天都很忙，工作也不敢懈怠，可一想到未来，心里还是没底。",
   "dur": 5.74
  },
  "v03": {
   "sec": "c0",
   "sub": "想换一份工作，担心下一份更不稳定；想做一点自己的事情，又怕承担不起试错的代价。",
   "dur": 7.1
  },
  "v04": {
   "sec": "c0",
   "sub": "以前想着，努力几年，生活总会慢慢好起来。",
   "dur": 4.08
  },
  "v05": {
   "sec": "c0",
   "sub": "现在更常想的是，眼前的日子，能不能先稳住。",
   "dur": 4.42
  },
  "v06": {
   "sec": "c1",
   "sub": "有人把这种感受叫作“时代的寒冬”。",
   "dur": 3.26
  },
  "v07": {
   "sec": "c1",
   "sub": "这个比喻能表达情绪。但如果想理解自己的处境，我们还需要往下问一步：这种冷，究竟从哪里来？",
   "dur": 8.09
  },
  "v08": {
   "sec": "c1",
   "sub": "我想从三个角度谈谈。",
   "dur": 2.28
  },
  "v09": {
   "sec": "c2",
   "sub": "首先，是我们熟悉的成功经验，可能已经不适合眼前的环境。",
   "dur": 5.09
  },
  "v10": {
   "sec": "c2",
   "sub": "很多人从小接受的教育是：好好读书，找份工作，踏实肯干，生活就会沿着一条比较清楚的路往前走。",
   "dur": 8.09,
   "screens": [
    "很多人从小接受的教育是：",
    "好好读书，找份工作，踏实肯干，",
    "生活就会沿着一条|比较清楚的路往前走。"
   ]
  },
  "v11": {
   "sec": "c2",
   "sub": "这些选择依然有价值。只是，它们不能保证每个人都得到相同的结果。",
   "dur": 6.07
  },
  "v12": {
   "sec": "c2",
   "sub": "举个例子。",
   "dur": 1.27
  },
  "v13": {
   "sec": "c2",
   "sub": "一家企业在扩张的时候，需要招人、开新业务。员工认真工作，有可能随着业务增长获得晋升。",
   "dur": 8.28
  },
  "v14": {
   "sec": "c2",
   "sub": "如果企业进入调整阶段，团队规模不再扩大，即使一个人比以前更努力，也未必会出现新的管理岗位。",
   "dur": 8.09
  },
  "v15": {
   "sec": "c2",
   "sub": "同样的努力，放在不同的环境里，回报可能很不一样。",
   "dur": 4.08
  },
  "v16": {
   "sec": "c2",
   "sub": "理解这一点，是为了让我们评价自己的时候，多看一层环境，少一点不必要的自责。",
   "dur": 6.6
  },
  "v17": {
   "sec": "c2",
   "sub": "父辈也经历过他们的困难。",
   "dur": 2.42
  },
  "v18": {
   "sec": "c2",
   "sub": "回看上一代，如果只看到买房获利、创业成功的人，就很容易忽略那些同样努力，却没有赶上机会的人。",
   "dur": 8.28,
   "screens": [
    "回看上一代，|如果只看到买房获利、创业成功的人，",
    "就很容易忽略那些同样努力，|却没有赶上机会的人。"
   ]
  },
  "v19": {
   "sec": "c2",
   "sub": "别人的人生结果，可以用来参考，却很难直接成为我们今天的行动路线。",
   "dur": 5.42
  },
  "v20": {
   "sec": "c3",
   "sub": "第二，是变化带来的机会，和个人能够接住的机会，中间存在距离。",
   "dur": 5.95
  },
  "v21": {
   "sec": "c3",
   "sub": "拿AI来说。",
   "dur": 1.61
  },
  "v22": {
   "sec": "c3",
   "sub": "假设一家设计公司引入了新工具，初稿制作变快了。这对企业可能意味着效率提高。",
   "dur": 6.96
  },
  "v23": {
   "sec": "c3",
   "sub": "但对员工而言，后续会怎样？",
   "dur": 2.76
  },
  "v24": {
   "sec": "c3",
   "sub": "可能是工作量增加，可能是岗位要求改变，也可能是公司开始更重视客户沟通、审美判断和项目交付。",
   "dur": 9.1,
   "screens": [
    "可能是工作量增加，|可能是岗位要求改变，",
    "也可能是公司开始更重视|客户沟通、审美判断和项目交付。"
   ]
  },
  "v25": {
   "sec": "c3",
   "sub": "工具进步，并不会自动变成每个人的加薪。",
   "dur": 3.77
  },
  "v26": {
   "sec": "c3",
   "sub": "一个人还需要学习新的用法，调整原来的工作方式，甚至重新寻找自己的位置。这些都需要时间。",
   "dur": 8.09
  },
  "v27": {
   "sec": "c3",
   "sub": "所以，“技术在进步”和“我暂时感到更焦虑”，完全可能同时发生。",
   "dur": 5.76,
   "screens": [
    "所以，“技术在进步”|和“我暂时感到更焦虑”，",
    "完全可能同时发生。"
   ]
  },
  "v28": {
   "sec": "c3",
   "sub": "当然，技术变化不能解释所有人的困境。行业、企业和家庭的情况都不同。",
   "dur": 6.43
  },
  "v29": {
   "sec": "c3",
   "sub": "但它提醒我们：看见一个新趋势，和从中获得实际收益，是两件需要分别考虑的事情。",
   "dur": 7.42
  },
  "v30": {
   "sec": "c4",
   "sub": "第三，是我们对未来的期待，正在和现实重新磨合。",
   "dur": 4.63
  },
  "v31": {
   "sec": "c4",
   "sub": "最让人难受的，有时是这样的落差：我已经按照过去被认可的方式付出了，为什么生活还没有走到预想的位置？",
   "dur": 7.97,
   "screens": [
    "最让人难受的，|有时是这样的落差：",
    "我已经按照|过去被认可的方式付出了，",
    "为什么生活|还没有走到预想的位置？"
   ]
  },
  "v32": {
   "sec": "c4",
   "sub": "到了某个年龄，应该有多少收入，应该买什么房，事业应该做到哪一步。",
   "dur": 5.76
  },
  "v33": {
   "sec": "c4",
   "sub": "这些标准，一旦变成固定的时间表，就容易让人觉得，自己一直在落后。",
   "dur": 6.1
  },
  "v34": {
   "sec": "c4",
   "sub": "可我们做选择的条件，本来就不相同。",
   "dur": 3.43
  },
  "v35": {
   "sec": "c4",
   "sub": "同样是辞职，有人可以用一年时间慢慢寻找方向，有人下个月就必须支付一家人的生活费。",
   "dur": 7.1,
   "screens": [
    "同样是辞职，|有人可以用一年时间慢慢寻找方向，",
    "有人下个月|就必须支付一家人的生活费。"
   ]
  },
  "v36": {
   "sec": "c4",
   "sub": "对后者来说，谨慎有它非常实际的理由。",
   "dur": 3.77
  },
  "v37": {
   "sec": "c4",
   "sub": "如果忽略这些差别，只用收入、职位和资产比较人生，就很难看清自己究竟走了多远。",
   "dur": 7.42,
   "screens": [
    "如果忽略这些差别，|只用收入、职位和资产比较人生，",
    "就很难看清|自己究竟走了多远。"
   ]
  },
  "v38": {
   "sec": "c5",
   "sub": "那么，理解这些之后，我们可以做些什么？",
   "dur": 3.29
  },
  "v39": {
   "sec": "c5",
   "sub": "我的建议是，先把目光从“一次改变命运”，移到“下一步怎样更稳、更有选择”。",
   "dur": 6.77
  },
  "v40": {
   "sec": "c5",
   "sub": "比如，想转行，可以先接触真实的岗位要求，做一个小项目，看看自己是否适应，再决定要不要投入更多。",
   "dur": 9.1
  },
  "v41": {
   "sec": "c5",
   "sub": "想学AI，也不必停留在收藏教程。挑一项每周都会重复的工作，试着用工具完成，检查它到底节省了多少时间，结果是否可靠。",
   "dur": 10.63
  },
  "v42": {
   "sec": "c5",
   "sub": "这样的尝试未必立刻改变收入，但能帮助我们用更小的代价，获得更具体的判断。",
   "dur": 6.43
  },
  "v43": {
   "sec": "c5",
   "sub": "也可以重新审视一下，我们用什么衡量自己的进步。",
   "dur": 4.27
  },
  "v44": {
   "sec": "c5",
   "sub": "除了职位和收入，有没有一项能力变得更扎实？遇到变化时，有没有比去年多一个选择？工作之外，身体和生活是否还承受得住？",
   "dur": 10.42,
   "screens": [
    "除了职位和收入，|有没有一项能力变得更扎实？",
    "遇到变化时，|有没有比去年多一个选择？",
    "工作之外，|身体和生活是否还承受得住？"
   ]
  },
  "v45": {
   "sec": "c5",
   "sub": "这些问题，同样值得认真回答。",
   "dur": 3.29
  },
  "v46": {
   "sec": "c6",
   "sub": "我不想把2020到2030这十年，提前写成一个已经注定的故事。",
   "tts": "我不想把二零二零到二零三零这十年，提前写成一个已经注定的故事。",
   "dur": 5.42
  },
  "v47": {
   "sec": "c6",
   "sub": "“寒冬”可以描述一种感受，却无法替我们预测每个人的未来。",
   "dur": 4.97
  },
  "v48": {
   "sec": "c6",
   "sub": "我们可以承认处境艰难，也可以暂时放慢脚步。与此同时，继续观察自己所在的行业，做一些承担得起的尝试，为下一次选择积累条件。",
   "dur": 11.62
  },
  "v49": {
   "sec": "c6",
   "sub": "对我来说，这就是当下值得做的事：照顾好眼前的生活，也给未来留一点空间。",
   "dur": 6.43
  }
 },
 "endNext": ""
}